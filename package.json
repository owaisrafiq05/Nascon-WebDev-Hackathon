{
  "name": "ubmp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unified Business Management Platform - lead protection, customizable CRM and real third-party integrations",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:watch": "pnpm build:packages && pnpm -r --parallel test:watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f mongo",
    "clean": "pnpm -r exec rm -rf dist coverage .vite *.tsbuildinfo",
    "seed": "pnpm --filter @ubmp/server seed",
    "check:integrations": "pnpm --filter @ubmp/server check:integrations",
    "e2e": "pnpm --filter @ubmp/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
