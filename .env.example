# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
#
# Every variable used by the running application is listed here. Variables marked
# "[added in Pn]" are declared now so the full surface is visible, but are not yet
# read or validated by any process; they become required in that phase.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (Q6)
# ---------------------------------------------------------------------------

# Points at the single-node replica set from docker-compose.yml.
# directConnection=true keeps the driver from trying to resolve the in-container
# hostname of the replica set member from the host machine.
MONGODB_URI=mongodb://localhost:27017/ubmp?replicaSet=rs0&directConnection=true

# ---------------------------------------------------------------------------
# API server (apps/server)
# ---------------------------------------------------------------------------

PORT=4000

# Comma-separated CORS allow-list. Must include the web app's dev origin.
WEB_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Worker (apps/worker)
# ---------------------------------------------------------------------------

# Heartbeat interval in milliseconds.
WORKER_HEARTBEAT_MS=5000

# How often the API relays realtime outbox events to sockets, in milliseconds (Q11).
OUTBOX_RELAY_INTERVAL_MS=500

# Where links in Telegram alerts and OAuth redirects point. Defaults to the
# first WEB_ORIGINS entry.
WEB_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Web app (apps/web) - Vite only exposes VITE_* to the browser.
# Never put a secret in a VITE_* variable (I5.3).
# ---------------------------------------------------------------------------

# Leave empty in development so the Vite dev-server proxy handles /api.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Sessions (P2)
#
# There is no session signing secret by design: session tokens are 32 random
# bytes and only their SHA-256 digest is stored, so there is no key to manage.
# See docs/decisions.md D29.
# ---------------------------------------------------------------------------

# How long a session lasts before it must be re-established. Default 720 (30 days).
SESSION_TTL_HOURS=720

# Failed sign-in attempts allowed per IP and email pair, and the window.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# How long an invitation stays usable. Default 168 (7 days).
INVITE_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Encryption (P6). Required to connect any integration.
# ---------------------------------------------------------------------------

# 32-byte key, base64, for AES-256-GCM encryption of provider tokens at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Integrations (P7 - P10)
# Each workspace connects its own credentials on the Integrations page (I5.2).
# The TWILIO_*, STRIPE_* and TELEGRAM_* values below are read ONLY by
# `pnpm seed`, to connect the demo workspace for you. Google OAuth is the
# platform's own client and is read by the server. See README.
# ---------------------------------------------------------------------------

# I1 Messaging - Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public HTTPS base URL that providers can reach (ngrok or cloudflared tunnel).
PUBLIC_BASE_URL=

# I2 Payments - Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# I3 Calendar - Google Calendar OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# I4 Notifications - Telegram bot
TELEGRAM_BOT_TOKEN=
