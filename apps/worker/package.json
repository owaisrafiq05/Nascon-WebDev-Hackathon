{
  "name": "@ubmp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Background process: claims persisted scheduled jobs and runs timers",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ubmp/domain": "workspace:*",
    "@ubmp/server": "workspace:*",
    "@ubmp/shared": "workspace:*",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@ubmp/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
